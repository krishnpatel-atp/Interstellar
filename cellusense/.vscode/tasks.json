{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CelluSense server",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "cellusense",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "CelluSense is running",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run tests",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
